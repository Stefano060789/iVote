{
  "crons": [
    {
      "path": "/api/cron?job=weekly-report",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron?job=check-anomalies",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron?job=purge-old-votes",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron?job=send-winback-emails",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
